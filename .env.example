APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# libpq connection string. Password may also come from PGPASSWORD/.pgpass.
DATABASE_URL=postgresql://root@localhost:5432/cbsrmt
DATABASE_MIN_POOL=1
DATABASE_MAX_POOL=10

# JWT validation for protected /users routes.
# Production should set AUTH_ENABLED=true and AUTH_JWKS_URL.
AUTH_ENABLED=false
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALGORITHMS=HS256,RS256
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH_CLIENT_ID=cbsrmt-local
OAUTH_CLIENT_SECRET=change-me
OAUTH_TOKEN_ALGORITHM=HS256
OAUTH_TOKEN_TTL_SECONDS=3600

# Comma-separated origins. Use explicit origins in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60

# Local episode audio library. Files are not stored in Git.
# Use four-digit filenames such as 0523.mp3.
AUDIO_ROOT=C:\\cbsrmt\\audio
AUDIO_URL_PREFIX=/audio
AUDIO_PUBLIC_BASE_URL=http://127.0.0.1:8000/audio
